        <object id="P3_footer" label="M04, M05 và M06 là cùng các thông điệp ở trang 01, được thể hiện lại ở mức chi tiết.&#10;Di chuyển / nhận / giao món là manual task; message flow chỉ mô tả thông tin. Việc gửi qua ứng dụng được giả định là Send Task." bpmnType="text">
          <mxCell vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#172b42;fontSize=13;fontColor=#52657a;">
