        <object id="P2_note1" label="(*) T = 5 phút là giả định để làm bài;&#10;đề chỉ cho 2 phút chờ nhà hàng.&#10;BT1 ngắt B02 khi hết hạn. BG0 chỉ nhập nhánh,&#10;không chờ đồng bộ." bpmnType="text">
