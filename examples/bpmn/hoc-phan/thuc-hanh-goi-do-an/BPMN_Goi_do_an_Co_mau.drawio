            <mxGeometry x="1535" y="500" width="590" height="65" as="geometry" />
          </mxCell>
        </object>
        <object id="P2_footer" label="Timer ngắt tạo một nhánh trong instance; B03 áp dụng quy tắc chốt trạng thái. Khóa/idempotency phải được thực hiện khi triển khai.&#10;Các start/end bên trong SP1 là start/end của subprocess; quy trình cha tiếp tục ở AG3 trên trang 01." bpmnType="text">
