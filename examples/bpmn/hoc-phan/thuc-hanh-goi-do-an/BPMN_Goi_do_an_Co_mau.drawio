          </mxCell>
        </object>
        <object id="P1_footer" label="Ký pháp: nét liền + mũi tên đặc = sequence flow trong một pool; nét đứt + vòng tròn rỗng = message flow giữa các pool.&#10;X = chọn đúng một nhánh; đồng hồ hai vòng nét liền = boundary timer ngắt tác vụ; dấu + trong SP1 = subprocess thu gọn." bpmnType="text">
