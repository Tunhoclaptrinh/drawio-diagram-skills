        <object id="P3_customer_note" label="Khách hàng nhận món vật lý tại D04; thông báo hoàn tất M07 do nền tảng gửi ở trang 01." bpmnType="text">
          <mxCell vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#172b42;fontSize=13;fontColor=#52657a;">
