        <object id="P3_note1" label="Chỉ phóng to nhánh giao thành công. Nhánh hủy sau thanh toán nằm ở trang 02.&#10;Các thông điệp được lưu và đối chiếu theo mã đơn; M14 có thể đến trước khi D01 chờ. D03a hoàn thành khi đã nhận món từ C04." bpmnType="text">
          <mxCell vertex="1" parent="P3_TX" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#172b42;fontSize=13;fontColor=#52657a;">
