        <object id="P2_note2" label="B03 chốt một trạng thái: ĐÃ GÁN hoặc ĐÃ HỦY.&#10;Chỉ gán khi có đề nghị hợp lệ và thời điểm chốt &lt; hạn chót.&#10;Không có đề nghị / chốt đúng hạn hoặc muộn: hủy. Chờ M05 mới nhận chuyến." bpmnType="text">
          <mxCell vertex="1" parent="SP1_EXP" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#172b42;fontSize=15;fontColor=#355574;">
