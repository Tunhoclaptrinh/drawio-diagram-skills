<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" pages="1">
  <diagram id="reservation" name="Đặt trước thiết bị dùng chung">
    <mxGraphModel page="1" pageScale="1" pageWidth="1450" pageHeight="800" grid="1" gridSize="10" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="TITLE" label="Đặt trước thiết bị dùng chung" bpmnType="text">
          <mxCell vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=25;fontColor=#172b42;strokeColor=none;strokeWidth=1.5;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;">
            <mxGeometry x="40" y="25" width="1370" height="50" as="geometry" />
          </mxCell>
        </object>
        <object id="CUSTOMER" label="Người đăng ký" bpmnType="participant" blackBox="true">
          <mxCell vertex="1" parent="1" style="swimlane;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#172b42;strokeColor=#334155;strokeWidth=1.5;fillColor=#e2e8f0;horizontal=0;startSize=48;container=1;collapsible=0;recursiveResize=0;fontStyle=1;swimlaneFillColor=#ffffff;">
            <mxGeometry x="80" y="110" width="1280" height="85" as="geometry" />
          </mxCell>
        </object>
        <object id="ORG" label="Đơn vị quản lý thiết bị" bpmnType="participant" blackBox="false">
          <mxCell vertex="1" parent="1" style="swimlane;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#172b42;strokeColor=#334155;strokeWidth=1.5;fillColor=#e2e8f0;horizontal=0;startSize=48;container=1;collapsible=0;recursiveResize=0;fontStyle=1;swimlaneFillColor=#ffffff;">
            <mxGeometry x="80" y="270" width="1280" height="470" as="geometry" />
          </mxCell>
        </object>
        <object id="FRONT" label="TIẾP NHẬN" bpmnType="lane">
          <mxCell vertex="1" parent="ORG" style="swimlane;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#172b42;strokeColor=#334155;strokeWidth=1.5;fillColor=#e2e8f0;horizontal=0;startSize=36;container=1;collapsible=0;recursiveResize=0;fontStyle=1;swimlaneFillColor=#ffffff;">
            <mxGeometry x="48" y="0" width="1232" height="225" as="geometry" />
          </mxCell>
        </object>
        <object id="STOCK" label="KHO THIẾT BỊ" bpmnType="lane">
          <mxCell vertex="1" parent="ORG" style="swimlane;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#172b42;strokeColor=#334155;strokeWidth=1.5;fillColor=#e2e8f0;horizontal=0;startSize=36;container=1;collapsible=0;recursiveResize=0;fontStyle=1;swimlaneFillColor=#ffffff;">
            <mxGeometry x="48" y="225" width="1232" height="245" as="geometry" />
          </mxCell>
        </object>
        <object id="S" label="Nhận yêu cầu" bpmnType="startEvent">
          <mxCell vertex="1" parent="FRONT" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#172b42;strokeColor=#334155;strokeWidth=1.5;fillColor=#bbf7d0;shape=mxgraph.bpmn.event;perimeter=ellipsePerimeter;aspect=fixed;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=145;spacingTop=8;outline=standard;symbol=message;">
            <mxGeometry x="62" y="85" width="38" height="38" as="geometry" />
          </mxCell>
        </object>
        <object id="CHECK" label="Kiểm tra số lượng&#10;có thể cấp" bpmnType="userTask">
          <mxCell vertex="1" parent="FRONT" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#172b42;strokeColor=#334155;strokeWidth=1.5;fillColor=#dbeafe;shape=mxgraph.bpmn.task2;rectStyle=rounded;arcSize=10;container=1;collapsible=0;spacingTop=8;taskMarker=user;">
            <mxGeometry x="182" y="63" width="220" height="85" as="geometry" />
          </mxCell>
        </object>
        <object id="G" label="Còn đủ thiết bị?" bpmnType="exclusiveGateway">
          <mxCell vertex="1" parent="FRONT" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#172b42;strokeColor=#334155;strokeWidth=1.5;fillColor=#fef08a;shape=mxgraph.bpmn.gateway2;perimeter=rhombusPerimeter;verticalLabelPosition=top;verticalAlign=bottom;labelWidth=150;spacingBottom=10;gwType=exclusive;outline=none;symbol=none;">
            <mxGeometry x="522" y="77" width="54" height="54" as="geometry" />
          </mxCell>
        </object>
        <object id="REJECT" label="Thông báo không đủ&#10;thiết bị" bpmnType="task">
          <mxCell vertex="1" parent="FRONT" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#172b42;strokeColor=#334155;strokeWidth=1.5;fillColor=#dbeafe;shape=mxgraph.bpmn.task2;rectStyle=rounded;arcSize=10;container=1;collapsible=0;spacingTop=8;taskMarker=abstract;">
            <mxGeometry x="722" y="63" width="220" height="85" as="geometry" />
          </mxCell>
        </object>
        <object id="E_NO" label="Không cấp được" bpmnType="endEvent">
          <mxCell vertex="1" parent="FRONT" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#172b42;strokeColor=#334155;strokeWidth=1.5;fillColor=#fecaca;shape=mxgraph.bpmn.event;perimeter=ellipsePerimeter;aspect=fixed;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=145;spacingTop=8;outline=end;symbol=general;">
            <mxGeometry x="1062" y="85" width="38" height="38" as="geometry" />
          </mxCell>
        </object>
        <object id="RESERVE" label="Ghi nhận đặt trước&#10;và giữ thiết bị" bpmnType="userTask">
          <mxCell vertex="1" parent="STOCK" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#172b42;strokeColor=#334155;strokeWidth=1.5;fillColor=#dbeafe;shape=mxgraph.bpmn.task2;rectStyle=rounded;arcSize=10;container=1;collapsible=0;spacingTop=8;taskMarker=user;">
            <mxGeometry x="722" y="70" width="220" height="85" as="geometry" />
          </mxCell>
        </object>
        <object id="E_OK" label="Đã giữ thiết bị" bpmnType="endEvent">
